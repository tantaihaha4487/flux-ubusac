{
  "manifest_version": 3,
  "name": "flux-ubusac",
  "version": "1.0.0",
  "description": "Overrides geolocation on the UBU registration prompt after detecting the target coordinates.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://dev.ubu.ac.th/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://dev.ubu.ac.th/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://dev.ubu.ac.th/*"]
    }
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "options_page": "options.html"
}
